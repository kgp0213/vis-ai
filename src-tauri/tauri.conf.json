{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visionox-Whale",
  "version": "1.28.0",
  "identifier": "com.visionox.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* https://tauri.localhost tauri://localhost; style-src 'unsafe-inline' 'self' http://127.0.0.1:*; font-src 'self' http://127.0.0.1:*; frame-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Viewer",
        "mimeType": "text/markdown",
        "rank": "Default"
      }
    ],
    "resources": {
      "runtime/visionox-pkg/": "resources/server/visionox-pkg/",
      "resources/server/launcher.mjs": "resources/server/launcher.mjs",
      "resources/server/lib/": "resources/server/lib/",
      "resources/server/learn.mjs": "resources/server/learn.mjs",
      "resources/server/learn-track.mjs": "resources/server/learn-track.mjs",
      "resources/server/learn-sandbox-impl.mjs": "resources/server/learn-sandbox-impl.mjs",
      "resources/server/visionox-file/": "resources/server/visionox-file/",
      "resources/server/node.exe": "resources/server/node.exe",
      "resources/server/officecli.exe": "resources/server/officecli.exe",
      "resources/server/dws.exe": "resources/server/dws.exe",
      "resources/runtime-manifest.json": "resources/runtime-manifest.json",
      "resources/third-party-resources.json": "resources/third-party-resources.json",
      "resources/bootstrap-skills-provenance.json": "resources/bootstrap-skills-provenance.json",
      "resources/THIRD_PARTY_NOTICES.md": "resources/THIRD_PARTY_NOTICES.md",
      "resources/DWS_LICENSE.txt": "resources/DWS_LICENSE.txt",
      "resources/DWS_NOTICE.txt": "resources/DWS_NOTICE.txt",
      "resources/default-soul.md": "resources/default-soul.md",
      "resources/ecc-rules/": "resources/ecc-rules/",
      "resources/skill-creation-guide.md": "resources/skill-creation-guide.md",
      "resources/bootstrap-skills/": "resources/bootstrap-skills/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "nodejs (>= 22)",
          "unzip",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
