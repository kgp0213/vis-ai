{
  "name": "visionox-whale",
  "version": "1.28.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "pretauri:dev": "node scripts/prepare-runtime-package.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/run-tauri-build.js",
    "bundle:nsis": "npm run tauri:build -- --bundles nsis && npm run verify:nsis",
    "check:bundle-patches": "node scripts/check-bundle-patches.js",
    "check:hygiene": "node scripts/check-repository-hygiene.js",
    "check:runtime-paths": "node scripts/check-runtime-paths.js",
    "check:runtime-manifest": "node scripts/verify-runtime-manifest.js",
    "check:versions": "node scripts/check-version-consistency.js",
    "verify:nsis": "node scripts/verify-nsis-bundle.js",
    "release:check": "node scripts/release-check.js",
    "restore:pkg": "node -e \"console.error('restore:pkg is disabled because it can overwrite local bundle patches. Use npm run restore:pkg:danger -- --force after backing up and reapplying patches.'); process.exit(1)\"",
    "restore:pkg:danger": "node scripts/restore-visionox-pkg.js --i-understand-overwrite-local-patches",
    "fetch:binaries": "node -e \"console.error('fetch:binaries is disabled for normal builds. Runtime binaries must already exist locally; use fetch:binaries:danger only after explicit network-download approval.'); process.exit(1)\"",
    "fetch:binaries:danger": "node scripts/fetch-binaries.js",
    "test": "node --test \"src-tauri/resources/server/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"src-tauri/resources/server/**/*.test.mjs\"",
    "test:coverage:core": "node --test --experimental-test-coverage --test-coverage-include=\"src-tauri/resources/server/lib/*.mjs\" --test-coverage-lines=90 --test-coverage-branches=60 --test-coverage-functions=90 \"src-tauri/resources/server/**/*.test.mjs\"",
    "test:ui:smoke": "node scripts/ui-smoke.js",
    "quality:check": "node scripts/quality-check.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
